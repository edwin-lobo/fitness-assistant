{
  "name": "fitness-assistant",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "node --test scripts/*.test.mjs tests/unit/*.test.mjs",
    "test:activity-check": "node --test scripts/supabase-activity-check.test.mjs",
    "test:portable-db": "node --test scripts/portable-db.test.mjs",
    "supabase:activity-check": "node scripts/supabase-activity-check.mjs",
    "db:local:start": "node scripts/portable-db.mjs start",
    "db:local:reset": "node scripts/portable-db.mjs reset",
    "db:test": "node scripts/portable-db.mjs test",
    "db:local:stop": "node scripts/portable-db.mjs stop",
    "lint": "eslint . --report-unused-disable-directives --max-warnings 0",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.105.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@types/react": "^18.2.66",
    "@types/react-dom": "^18.2.22",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@vitejs/plugin-react": "^5.0.4",
    "autoprefixer": "^10.4.19",
    "eslint": "^8.57.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.6",
    "globals": "^15.8.0",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.4",
    "typescript": "^5.5.3",
    "vite": "^5.2.0"
  }
}
